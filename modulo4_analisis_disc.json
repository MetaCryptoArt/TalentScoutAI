import { getEmpresaSession } from "@/lib/auth";
import { getCandidatesForCompany } from "@/lib/sheets";
import { Metrics, CandidateTable } from "@/components/ui";
import type { Candidate } from "@/lib/types";

export const dynamic = "force-dynamic";

export default async function PortalHome() {
  const session = await getEmpresaSession();
  let candidates: Candidate[] = [];
  let error = "";
  try {
    candidates = session ? await getCandidatesForCompany(session.companyName) : [];
  } catch (e) {
    error = (e as Error).message;
  }

  return (
    <>
      <div className="page-title">Candidatos</div>
      <div className="page-sub">Resultados de pre-calificación de {session?.companyName}</div>
      {error ? (
        <div className="card">
          <div className="empty">
            No se pudieron cargar los datos.<br />
            <span style={{ fontSize: 13 }}>{error}</span>
          </div>
        </div>
      ) : (
        <>
          <Metrics candidates={candidates} />
          <CandidateTable candidates={candidates} basePath="/portal/candidato" />
        </>
      )}
    </>
  );
}
